# Copy to .env.local and fill in your Supabase project values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MyFolio
NEXT_PUBLIC_PORTFOLIO_URL_MODE=path
NEXT_PUBLIC_ROOT_DOMAIN=

# Optional. Google Maps Embed API key used by the Location section. Restrict the
# key by HTTP referrer in Google Cloud. When empty, the map falls back to a
# keyless Google Maps embed so local development still works.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
